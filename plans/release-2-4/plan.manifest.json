  "validation": {
    "commands": [
      "python3 -c 'import os; expected=os.environ.get(\"ALK_ACCEPTED_PREDECESSOR_SHA\"); actual=os.environ.get(\"ALK_RELEASE_BASE_SHA\"); raise SystemExit(0 if expected and actual == expected else \"set both SHAs to the latest accepted mandatory baseline rooted at Release 2.0 before freeze\")'",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -m unittest tests.contracts.test_security_analysis_schemas tests.quality.test_security_analysis tests.workflow.test_security_analysis_profile tests.imports.test_security_findings tests.cli.test_security_analysis_commands -q",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -m unittest discover -s tests -t . -v",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 tools/release/validate_module_dependencies.py --package-root src/agent_lifecycle --policy policy/architecture-dependencies.json --require-acyclic-modules --require-acyclic-packages --evidence work/release-2-4/evidence/module-dependencies.json",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 tools/release/validate_architecture_complexity.py --package-root src/agent_lifecycle --target-file-lines 800 --hard-file-lines 1200 --target-function-lines 80 --hard-function-lines 150 --hard-symbols 80 --evidence work/release-2-4/evidence/architecture-complexity.json",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 tools/release/validate_docs_compat.py --evidence work/release-2-4/evidence/docs-compat.json",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -m agent_lifecycle.neutrality scan --scope tracked-release --policy policy/neutrality.policy.json --report work/release-2-4/evidence/neutrality.json --require-zero-findings",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 tools/release/validate_publication_versions.py --target-version 2.4.0 --target-ref v2.4.0 --evidence work/release-2-4/evidence/publication-versions.json",
      "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 tools/release/validate_publication_adoption.py --target-version 2.4.0 --evidence work/release-2-4/evidence/publication-adoption.json"
    ],
