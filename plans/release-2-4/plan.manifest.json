    "requirements": [
      {
        "id": "R93-PROFILE",
        "description": "Define an optional security analysis profile with threat model, suspected finding, exploitability evidence, deduplication, remediation and verification stages."
      },
      {
        "id": "R93-FINDINGS",
        "description": "Define normalized security finding and SARIF mapping with stable IDs, severity, confidence, source revision and redacted locations."
      },
      {
        "id": "R93-EXECUTION",
        "description": "Require explicit plan opt-in, sandbox and budgets for any active reproduction; safe static or synthetic evidence remains the default."
      },
      {
        "id": "R93-REVIEW",
        "description": "Require a separate verification assignment for accepted high-severity remediation and preserve failed or disputed evidence."
      },
      {
        "id": "R93-DOCUMENTATION",
        "description": "Document safe security analysis in English and Russian, including authorization and disclosure boundaries."
      },
      {
        "id": "R93-ACTIVATION",
        "description": "Preserve the accepted mandatory baseline through Release 2.0, reconcile any separately accepted candidate releases, and require a safe end-to-end security fixture before freeze."
      }
    ],
