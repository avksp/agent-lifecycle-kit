    "requirements": [
      {
        "id": "R25-CONTRACT",
        "description": "Define external-tool job request, status and result contracts with QUEUED, RUNNING, SUCCEEDED, FAILED, CANCELLED and EXPIRED states."
      },
      {
        "id": "R25-LIMITS",
        "description": "Require adapter-owned process or network execution with explicit time, attempt, output, artifact, cost and cancellation limits; terminal parents cancel and account for every declared child."
      },
      {
        "id": "R25-ARTIFACTS",
        "description": "Store only bounded metadata, media type, size, digest and controlled locator for generated artifacts."
      },
      {
        "id": "R25-QUALIFICATION",
        "description": "Qualify each adapter operation with success, timeout, cancellation, process-group cleanup, parent-terminal child cancellation, post-cancel write rejection, replay, stale result, oversized artifact and no-final-verdict scenarios."
      },
      {
        "id": "R25-DOCUMENTATION",
        "description": "Document bounded external-tool jobs in English and Russian with one neutral adapter example."
      },
      {
        "id": "R25-ACTIVATION",
        "description": "Bind the two activated incident shapes, preserve synchronous Release 1.88 checks and keep ordinary workflows free of job state."
      }
    ],
